# 复制为 .env 后按需修改。.env 不进 git。
# 端口冲突时改这里，不改 compose.yaml。

DB_ROOT_PASSWORD=123
ADMIN_PASSWORD=admin

WEB_PORT=8000
# 9000 常落在 Windows/Hyper-V 保留端口段（netsh interface ipv4 show excludedportrange
# protocol=tcp 可查），故默认用 9100。容器内仍是 9000。
SOCKETIO_PORT=9100
WATCH_PORT=6787

SITE_NAME=erx.localhost
BENCH_NAME=frappe-bench

# seed-demo.sh 建公司时用的信息。含空格的值必须加引号——脚本用 . ./.env 载入，
# 不加引号会被当命令执行（报 "Demo: command not found"）。
COMPANY_NAME="ERX Demo"
COMPANY_ABBR=ERX
COMPANY_COUNTRY=China
COMPANY_CURRENCY=CNY
COMPANY_TIMEZONE=Asia/Shanghai

# 界面语言（zh=简体中文，en=English）
UI_LANGUAGE=zh

