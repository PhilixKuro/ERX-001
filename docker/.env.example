# 复制为 .env 后按需修改。.env 不进 git。
# 端口冲突时改这里，不改 compose.yaml。

DB_ROOT_PASSWORD=123
ADMIN_PASSWORD=admin

WEB_PORT=8000
# 实时端口。9000 常落在 Windows/Hyper-V 保留端口段（netsh interface ipv4 show excludedportrange
# protocol=tcp 可查），故用 9100。站点配置 socketio_port、realtime-proxy 的发布端口与模板都取这一项；
# 改它之后跑 `docker/up.sh`、重启 `docker/start.sh` 并刷新已开的页面，见 README「端口」节。
SOCKETIO_PORT=9100
WATCH_PORT=6787

SITE_NAME=erx.localhost
BENCH_NAME=frappe-bench

# seed-demo.sh 建公司时用的信息。含空格的值必须加引号——脚本用 . ./.env 载入，
# 不加引号会被当命令执行（报 "Demo: command not found"）。
COMPANY_NAME="ERX Demo"
COMPANY_ABBR=ERX
COMPANY_COUNTRY=China
COMPANY_CURRENCY=CNY
COMPANY_TIMEZONE=Asia/Shanghai

# 界面语言（zh=简体中文，en=English）
UI_LANGUAGE=zh


# 容器内 git 走的代理。容器里的 127.0.0.1 是容器自己，故用 host.docker.internal
# 指向宿主机。无需代理的网络环境留空即可。
GIT_PROXY=http://host.docker.internal:7897

# Raven 连 LiteLLM 用（只有配置 Raven 连接时才需要）。三个须一起设：不设 MODEL 时
# bot 取 Raven 缺省 gpt-4o。密钥只放这里，不写进任何文档、日志。
RAVEN_LLM_URL=
RAVEN_LLM_KEY=
RAVEN_LLM_MODEL=
