map $http_origin $frappe_site_header {
    default "${SITE_NAME}";
    "" "";
    "~^https?://(localhost|127\.0\.0\.1|[^/:]+\.localhost)(:\d+)?$" "";
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
}

server {
    # 端口取 .env 的 SOCKETIO_PORT（compose 传入），与站点配置 socketio_port 同源（P1-S5-R10 FD-038）
    listen ${SOCKETIO_PORT};

    location / {
        proxy_pass http://frappe:${SOCKETIO_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Frappe-Site-Name $frappe_site_header;
        proxy_read_timeout 1h;
    }
}
