  "multisegment_get_columns_source": "\tdef get_columns(self, segments: list[SegmentData], base_columns: list[dict]) -> list[dict]:\n\t\tcolumns = []\n\n\t\t# TODO: Refactor\n\t\tfor segment in segments:\n\t\t\tfor col in base_columns:\n\t\t\t\tnew_col = col.copy()\n\n\t\t\t\tnew_col[\"fieldname\"] = f\"{segment.id}_{col['fieldname']}\"\n\n\t\t\t\tif col[\"fieldname\"] == \"account\":\n\t\t\t\t\tnew_col[\"label\"] = segment.label or f\"Account (Segment {segment.index + 1})\"\n\t\t\t\t\tnew_col[\"align\"] = \"left\"\n\n\t\t\t\tif segment.label and col[\"fieldname\"] in [p[\"key\"] for p in self.period_list]:\n\t\t\t\t\tnew_col[\"label\"] = f\"{segment.label} - {col['label']}\"\n\n\t\t\t\tcolumns.append(new_col)\n\n\t\treturn columns\n",
  "segment_label_is_translated": {
    "uses_underscore_call_on_segment_label": false,
    "note": "if False, the Chinese string is passed through verbatim, no translation layer"
  },
  "get_label_source": "def get_label(periodicity, from_date, to_date):\n\tif periodicity == \"Yearly\":\n\t\tif formatdate(from_date, \"YYYY\") == formatdate(to_date, \"YYYY\"):\n\t\t\tlabel = formatdate(from_date, \"YYYY\")\n\t\telse:\n\t\t\tlabel = formatdate(from_date, \"YYYY\") + \"-\" + formatdate(to_date, \"YYYY\")\n\telse:\n\t\tlabel = formatdate(from_date, \"MMM YY\") + \"-\" + formatdate(to_date, \"MMM YY\")\n\n\treturn label\n",
